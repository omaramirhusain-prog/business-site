# Public site and authentication URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate with: npx auth secret
BETTER_AUTH_SECRET=

# Production PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/database
# Set false only for a local PostgreSQL server without TLS.
DATABASE_SSL=true

# Comma-separated addresses that bootstrap as administrators.
# Administrators must enroll an authenticator app before opening /admin.
ADMIN_EMAILS=admin@example.com

# Account and invitation emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=Omar Husain <accounts@example.com>

# Local development alternative to PostgreSQL
# AUTH_USE_LOCAL_DB=true
# AUTH_LOCAL_DB_PATH=/tmp/business-site-auth.sqlite
# AUTH_DEV_EMAIL_MODE=console
